# Optional local database location. Set this in your shell before importing/serving.
# The application does not automatically load .env files.
BDZ_DATABASE_PATH=var/biodiscoveryz.sqlite

# Choose local development data explicitly. Db2 mode fails closed until its
# actual schema, network access, and backend mapping have been verified.
BDZ_DATA_SOURCE=sqlite

# Optional authorized Db2 connectivity probe. Set these in the environment, not
# in a committed .env file. A populated Db2 database is never reimported here.
# BDZ_DB2_HOST=
# BDZ_DB2_PORT=
# BDZ_DB2_DATABASE=
# BDZ_DB2_USERNAME=
# BDZ_DB2_PASSWORD=
# BDZ_DB2_SSL_CERTIFICATE=
