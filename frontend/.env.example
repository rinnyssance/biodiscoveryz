# Base URL the browser uses for API requests.
# Leave empty during local development: Vite's dev proxy forwards /api, /fhir and
# /health to the backend from the same origin, so no CORS change is needed.
# Set it only if the backend owner has deliberately allowed this site's origin.
VITE_API_BASE_URL=

# Where the Vite dev proxy forwards requests (development only, never sent to the browser).
BDZ_BACKEND_URL=http://127.0.0.1:8000

# Never put database credentials, Db2 settings or patient data in this file:
# every VITE_ variable is visible to anyone who loads the site.
